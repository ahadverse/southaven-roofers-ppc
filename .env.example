# Copy this file to .env.local for local development.
# On Vercel: Project → Settings → Environment Variables, then Redeploy.

# REQUIRED. Default tracking phone number (E.164: +1 and 10 digits). The admin panel can override it;
# this value is the fallback, and the build fails if it is missing or malformed.
NEXT_PUBLIC_PHONE_NUMBER=+16625550100

# Live site address, no trailing slash. Used for canonical URLs, sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://southavenroofers.com

# Email for privacy/legal questions (shown on Contact, Privacy and Terms pages). Use a mailbox you check.
NEXT_PUBLIC_CONTACT_EMAIL=contact@southavenroofers.com

# OPTIONAL. Only set this if your network confirms the hours calls are answered, e.g. "Mon–Sat, 7am–7pm".
# NEXT_PUBLIC_CALL_HOURS=

# ───────── MongoDB (content, settings and call-click stats for the admin panel) ─────────
# MongoDB Atlas → Connect → Drivers. Atlas → Network Access must allow 0.0.0.0/0 for Vercel.
# Without it, the site serves the starter markdown in /content and the admin panel is read-only.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=southaven_roofers
# Local only, if you see "querySrv ECONNREFUSED": use public DNS servers. Leave unset on Vercel.
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# ───────── Admin login (/admin) ─────────
ADMIN_USERNAME=admin
# At least 10 characters. Use a long, unique password.
ADMIN_PASSWORD=
# At least 32 random characters, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
